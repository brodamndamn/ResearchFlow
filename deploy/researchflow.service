[Unit]
Description=ResearchFlow FastAPI 服务
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/researchflow/backend
EnvironmentFile=/opt/researchflow/backend/.env
# ExecStart 中的 env 是进程最终值，不会被 EnvironmentFile 覆盖。
ExecStart=/usr/bin/env RESEARCHFLOW_ENVIRONMENT=production /opt/researchflow/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8001 --workers 1
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/researchflow/backend/data

[Install]
WantedBy=multi-user.target
