APP_ENV=development
APP_DATABASE_URL=sqlite+aiosqlite:///./data/app.db
CHECKPOINT_DATABASE_PATH=./data/checkpoints.db
LLM_API_KEY=请替换为你的模型密钥
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
TAVILY_API_KEY=请替换为你的Tavily密钥
IP_HASH_SECRET=请替换为至少32位的随机字符串
TRUSTED_PROXIES=127.0.0.1,::1
QUICK_DAILY_LIMIT=3
DEEP_DAILY_LIMIT=1
QUEUE_CAPACITY=3
QUICK_TIMEOUT_SECONDS=90
DEEP_TIMEOUT_SECONDS=180
REPORT_RETENTION_DAYS=7
