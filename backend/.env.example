RESEARCHFLOW_ENVIRONMENT=development
# 本机无 Key 演示可改为 fake；服务器部署请保持 real
RESEARCHFLOW_PROVIDER_MODE=real
RESEARCHFLOW_DATABASE_PATH=./data/researchflow.sqlite3
RESEARCHFLOW_CHECKPOINT_DATABASE_PATH=./data/checkpoints.sqlite3
RESEARCHFLOW_MODEL_API_KEY=请替换为你的模型密钥
RESEARCHFLOW_MODEL_BASE_URL=https://api.deepseek.com
RESEARCHFLOW_MODEL_NAME=deepseek-v4-flash
RESEARCHFLOW_TAVILY_API_KEY=请替换为你的Tavily密钥
RESEARCHFLOW_IP_HASH_SECRET=请替换为至少32位的随机字符串
RESEARCHFLOW_QUICK_DAILY_LIMIT=3
RESEARCHFLOW_DEEP_DAILY_LIMIT=1
RESEARCHFLOW_QUEUE_ACTIVE_LIMIT=1
RESEARCHFLOW_QUEUE_WAITING_LIMIT=3
RESEARCHFLOW_QUICK_TIMEOUT_SECONDS=90
RESEARCHFLOW_DEEP_TIMEOUT_SECONDS=180
RESEARCHFLOW_RETENTION_DAYS=7
